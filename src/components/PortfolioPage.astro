---
import "../styles/portfolio.css";
import { portfolioContent, portfolioLinks } from "../data/portfolioContent";

type PortfolioContent = (typeof portfolioContent)[keyof typeof portfolioContent];

const page = (Astro.props.content ?? portfolioContent.en) as PortfolioContent;
const [featuredClientEngagement, ...otherClientEngagements] = page.clientEngagements;

const siteUrl = Astro.site ?? new URL("https://portfolio.badismerakchi.com");
const canonicalPath = page.lang === "fr" ? "/fr/" : "/";
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const englishUrl = new URL("/", siteUrl).href;
const frenchUrl = new URL("/fr/", siteUrl).href;
const socialImageUrl = new URL("/og-portfolio.png", siteUrl).href;
const socialImageAlt = page.lang === "fr"
  ? "Badis Merakchi — Ingénieur Cloud & DevOps"
  : "Badis Merakchi — Cloud & DevOps Engineer";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Badis Merakchi",
  url: englishUrl,
  image: socialImageUrl,
  jobTitle: page.lang === "fr" ? "Ingénieur Cloud & DevOps" : "Cloud & DevOps Engineer",
  description: page.description,
  workLocation: {
    "@type": "Place",
    name: page.lang === "fr" ? "Région de Genève, Suisse" : "Geneva area, Switzerland",
  },
  sameAs: [portfolioLinks.github, portfolioLinks.linkedin, portfolioLinks.consulting],
  mainEntityOfPage: canonicalUrl,
};

const heroUi = page.lang === "fr"
  ? {
      portfolioLabel: "Portfolio technique de Badis Merakchi",
      projectsButton: "Voir mes projets",
      profileLinksLabel: "Profils professionnels",
      credibilityLabel: "Compétences techniques clés",
      credibilityChips: ["Terraform", "AWS · Azure · OCI", "CI/CD", "Kubernetes", "Linux"],
    }
  : {
      portfolioLabel: "Badis Merakchi's technical portfolio",
      projectsButton: "View my projects",
      profileLinksLabel: "Professional profiles",
      credibilityLabel: "Core technical skills",
      credibilityChips: ["Terraform", "AWS · Azure · OCI", "CI/CD", "Kubernetes", "Linux"],
    };
---

<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content="Badis Merakchi" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Badis Merakchi — Technical Portfolio" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={page.lang === "fr" ? "fr_CH" : "en_CH"} />
    <meta property="og:locale:alternate" content={page.lang === "fr" ? "en_CH" : "fr_CH"} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="profile:first_name" content="Badis" />
    <meta property="profile:last_name" content="Merakchi" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {page.lang === "fr" ? "Aller au contenu principal" : "Skip to main content"}
    </a>

    <header class="site-header">
      <div class="header page">
        <a
          class="logo"
          href={page.lang === "fr" ? "/fr" : "/"}
          aria-label={page.lang === "fr" ? "Badis Merakchi — Accueil" : "Badis Merakchi — Home"}
        >
          <span class="logo-mark" aria-hidden="true">BM</span>
          <span class="logo-name">Badis Merakchi</span>
        </a>

        <nav class="main-nav" aria-label={page.lang === "fr" ? "Navigation principale" : "Main navigation"}>
          <a href="#skills">{page.nav.skills}</a>
          <a href="#experience">{page.nav.experience}</a>
          <a href="#projects">{page.nav.projects}</a>
          <a href="#contact">{page.nav.contact}</a>
          <a href={portfolioLinks.cv}>CV</a>
        </nav>

        <div class="header-actions">
          <a
            class="consulting-link"
            href={portfolioLinks.consulting}
            target="_blank"
            rel="noreferrer"
          >
            Consulting ↗
          </a>

          <div class="language-switch" aria-label={page.languageLabel}>
            <a class:list={[page.lang === "en" && "active"]} href="/" aria-current={page.lang === "en" ? "page" : undefined}>EN</a>
            <a class:list={[page.lang === "fr" && "active"]} href="/fr" aria-current={page.lang === "fr" ? "page" : undefined}>FR</a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="page">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-context">{page.hero.status}</p>

          <p class="hero-kicker">{heroUi.portfolioLabel}</p>

          <h1 id="hero-title">{page.hero.title}</h1>

          <p class="lead">{page.hero.lead}</p>

          <div class="actions">
            <a class="button primary" href="#projects">{heroUi.projectsButton}</a>
            <a class="button secondary" href={portfolioLinks.cv}>{page.hero.cvButton}</a>
          </div>

          <div class="hero-tertiary-links" aria-label={heroUi.profileLinksLabel}>
            <a href={portfolioLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={portfolioLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href={portfolioLinks.consulting} target="_blank" rel="noreferrer">Consulting ↗</a>
          </div>

          <ul class="credibility-chips" aria-label={heroUi.credibilityLabel}>
            {heroUi.credibilityChips.map((chip) => <li>{chip}</li>)}
          </ul>

          <p class="hero-availability">
            <span aria-hidden="true"></span>
            {page.hero.availability}
          </p>
        </div>
      </section>

      <section id="skills" class="section">
        <div class="section-head">
          <p>{page.skillsSection.eyebrow}</p>
          <h2>{page.skillsSection.title}</h2>
        </div>

        <div class="skills-grid">
          {page.skills.map(([label, value]) => (
            <div class="skill-card">
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </section>

      <section id="experience" class="section">
        <div class="section-head experience-section-head">
          <div>
            <p>{page.experienceSection.eyebrow}</p>
            <h2>{page.experienceSection.title}</h2>
          </div>
          <div class="experience-meta">
            <span>{page.experienceSection.oracleLocation}</span>
            <span>{page.experienceSection.oraclePeriod}</span>
          </div>
        </div>

        <article class="experience">
          <p class="experience-summary">{page.experienceSection.oracleDescription}</p>

          <article class="featured-client-engagement">
            <div class="featured-client-label">
              <span>{page.experienceSection.featuredEngagementLabel}</span>
              <strong>{featuredClientEngagement.client}</strong>
            </div>
            <div class="featured-client-copy">
              <h3>{featuredClientEngagement.title}</h3>
              <ul>
                {featuredClientEngagement.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </article>

          <div class="experience-engagements">
            <h4>{page.experienceSection.engagementsTitle}</h4>
            <div class="client-engagement-grid">
              {otherClientEngagements.map((engagement) => (
                <article class="client-engagement-card">
                  <span>{engagement.client}</span>
                  <div class="client-engagement-copy">
                    <h3>{engagement.title}</h3>
                    <ul>
                      {engagement.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="experience-proof-strip" aria-label={page.experienceSection.proofSummaryLabel}>
            {page.experienceSection.proofItems.map((item) => <span>{item}</span>)}
          </div>

          <div class="cross-client-delivery">
            <h4>{page.experienceSection.crossClientTitle}</h4>
            <ul class="cross-client-list">
              {page.crossClientDelivery.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>

        <div class="additional-experience-grid">
          {page.additionalExperiences.map((item) => (
            <article class="additional-experience-card">
              <div>
                <span>{item.company}</span>
                <h3>{item.role}</h3>
              </div>

              <p>{item.description}</p>

              <div class="compact-tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="projects" class="section">
        <div class="section-head">
          <p>{page.projectsSection.eyebrow}</p>
          <h2>{page.projectsSection.title}</h2>
        </div>

        <article class="featured-project-card">
          <div class="featured-copy">
            <div class="featured-topline">
              <p class="featured-label">{page.projectsSection.featuredLabel}</p>
            </div>

            <h3>{page.featuredProject.title}</h3>
            <p>{page.featuredProject.description}</p>
            <p class="featured-proof">{page.featuredProject.proof}</p>

            <div class="featured-metrics">
              {page.featuredProject.metrics.map(([label, value]) => (
                <div>
                  <span>{label}</span>
                  <strong>{value}</strong>
                </div>
              ))}
            </div>
          </div>

          <div class="featured-meta">
            <div>
              <h4>{page.projectsSection.scopeTitle}</h4>
              <ul class="featured-highlights">
                {page.featuredProject.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>

            <div>
              <h4>{page.projectsSection.stackTitle}</h4>
              <div class="tags">
                {page.featuredProject.stack.map((item) => <span>{item}</span>)}
              </div>
            </div>

            <a href={page.featuredProject.link} target="_blank" rel="noopener noreferrer">{page.projectsSection.featuredRepositoryLabel}</a>
          </div>
        </article>

        <article class="spotlight-project-card">
          <div class="spotlight-copy">
            <div class="featured-topline">
              <p class="featured-label">{page.projectsSection.spotlightLabel}</p>
            </div>

            <h3>{page.spotlightProject.title}</h3>
            <p>{page.spotlightProject.description}</p>
            <p class="featured-proof">{page.spotlightProject.proof}</p>

            <div class="featured-metrics">
              {page.spotlightProject.metrics.map(([label, value]) => (
                <div>
                  <span>{label}</span>
                  <strong>{value}</strong>
                </div>
              ))}
            </div>
          </div>

          <div class="spotlight-meta">
            <div>
              <h4>{page.projectsSection.scopeTitle}</h4>
              <ul class="featured-highlights">
                {page.spotlightProject.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>

            <div>
              <h4>{page.projectsSection.stackTitle}</h4>
              <div class="tags">
                {page.spotlightProject.stack.map((item) => <span>{item}</span>)}
              </div>
            </div>

            <a href={page.spotlightProject.link} target="_blank" rel="noopener noreferrer">
              {page.projectsSection.spotlightRepositoryLabel}
            </a>
          </div>
        </article>

        <div class="project-subhead-card">
          <div>
            <p>{page.projectsSection.otherEyebrow}</p>
            <h3>{page.projectsSection.otherTitle}</h3>
          </div>
        </div>

        <div class="projects-grid">
          {page.projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>

              <div class="tags">
                {project.stack.map((item) => <span>{item}</span>)}
              </div>

              <div class="project-links">
                {"liveUrl" in project && project.liveUrl && (
                  <a class="project-link live" href={project.liveUrl} target="_blank" rel="noopener noreferrer">{page.projectsSection.liveSiteLabel}</a>
                )}
                <a class="project-link" href={project.link} target="_blank" rel="noopener noreferrer">{page.projectsSection.repositoryLabel}</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="section contact">
        <div>
          <p class="status danger">{page.contactSection.eyebrow}</p>
          <h2>{page.contactSection.title}</h2>
          <p class="contact-intro">{page.contactSection.intro}</p>
        </div>

        <div class="contact-panel">
          <div>
            <span>{page.contactSection.emailLabel}</span>
            <a href={`mailto:${portfolioLinks.email}`}>{portfolioLinks.email}</a>
          </div>

          <div>
            <span>{page.contactSection.locationLabel}</span>
            <strong>{page.contactSection.locationValue}</strong>
          </div>

          <div>
            <span>{page.contactSection.availabilityLabel}</span>
            <strong>{page.contactSection.availabilityValue}</strong>
          </div>

          <div>
            <span>{page.contactSection.profilesLabel}</span>
            <a href={portfolioLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={portfolioLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <p>{page.footer}</p>
      </footer>
    </main>
  </body>
</html>
