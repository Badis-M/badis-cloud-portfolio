---
import "../styles/portfolio.css";
import { portfolioContent, portfolioLinks } from "../data/portfolioContent";
import { portfolioPresentation, education, certifications, earlierExperiences } from "../data/portfolioPresentation";

type PortfolioContent = (typeof portfolioContent)[keyof typeof portfolioContent];

const page = (Astro.props.content ?? portfolioContent.en) as PortfolioContent;
const [featuredClientEngagement, ...otherClientEngagements] = page.clientEngagements;
const ui = portfolioPresentation[page.lang as "fr" | "en"];
const [availabilityLabel, availabilityContext] = ui.status.split(" — ");

const siteUrl = Astro.site ?? new URL("https://portfolio.badismerakchi.com");
const canonicalPath = page.lang === "fr" ? "/fr/" : "/";
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const englishUrl = new URL("/", siteUrl).href;
const frenchUrl = new URL("/fr/", siteUrl).href;
const socialImageUrl = new URL("/og-portfolio.png", siteUrl).href;
const socialImageAlt = page.lang === "fr"
  ? "Badis Merakchi — Ingénieur Cloud & DevOps"
  : "Badis Merakchi — Cloud & DevOps Engineer";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Badis Merakchi",
  url: englishUrl,
  image: socialImageUrl,
  jobTitle: page.lang === "fr" ? "Ingénieur Cloud & DevOps" : "Cloud & DevOps Engineer",
  description: page.description,
  workLocation: {
    "@type": "Place",
    name: page.lang === "fr" ? "Lausanne et Genève, Suisse" : "Lausanne and Geneva, Switzerland",
  },
  sameAs: [portfolioLinks.github, portfolioLinks.linkedin, portfolioLinks.consulting],
  mainEntityOfPage: canonicalUrl,
};

const heroUi = page.lang === "fr"
  ? {
      portfolioLabel: "Portfolio technique de Badis Merakchi",
      projectsButton: "Voir mes projets",
      profileLinksLabel: "Profils professionnels",
      credibilityLabel: "Compétences techniques clés",
      credibilityChips: ["Terraform", "AWS · Azure · OCI", "CI/CD", "Kubernetes", "Linux"],
    }
  : {
      portfolioLabel: "Badis Merakchi's technical portfolio",
      projectsButton: "View my projects",
      profileLinksLabel: "Professional profiles",
      credibilityLabel: "Core technical skills",
      credibilityChips: ["Terraform", "AWS · Azure · OCI", "CI/CD", "Kubernetes", "Linux"],
    };
---

<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content="Badis Merakchi" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Badis Merakchi — Technical Portfolio" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={page.lang === "fr" ? "fr_CH" : "en_CH"} />
    <meta property="og:locale:alternate" content={page.lang === "fr" ? "en_CH" : "fr_CH"} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="profile:first_name" content="Badis" />
    <meta property="profile:last_name" content="Merakchi" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{page.lang === "fr" ? "Aller au contenu principal" : "Skip to main content"}</a>
    <header class="site-header">
      <div class="header container">
        <a class="logo" href={page.lang === "fr" ? "/fr/" : "/"} aria-label={page.lang === "fr" ? "Badis Merakchi — Accueil" : "Badis Merakchi — Home"}>Badis M</a>
        <nav class="main-nav" aria-label={page.lang === "fr" ? "Navigation principale" : "Main navigation"}>
          <a href="#experience">{page.nav.experience}</a>
          <a href="#skills">{page.nav.skills}</a>
          <a href="#projects">{page.nav.projects}</a>
          <a href="#contact">{page.nav.contact}</a>
        </nav>
        <div class="header-actions">
          <div class="language-switch" aria-label={page.languageLabel}>
            <a href="/fr/" aria-current={page.lang === "fr" ? "page" : undefined}>FR</a>
            <a href="/" aria-current={page.lang === "en" ? "page" : undefined}>EN</a>
          </div>
          <a class="header-cv" href={portfolioLinks.cv}>CV ↗</a>
        </div>
      </div>
    </header>

    <main id="main-content" class="container">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="availability"><span class="availability-dot" aria-hidden="true"></span><span><span class="availability-label">{availabilityLabel}</span> — {availabilityContext}</span></p>
          <p class="hero-name">Badis Merakchi</p>
          <h1 id="hero-title" class="text-gradient">{ui.role}</h1>
          <p class="hero-value">{ui.value}</p>
          <p class="hero-intro">{page.hero.lead}</p>
          <div class="actions">
            <a class="button primary" href={portfolioLinks.cv}>{page.hero.cvButton}</a>
            <a class="button secondary" href="#projects">{heroUi.projectsButton}</a>
          </div>
          <div class="profile-links" aria-label={heroUi.profileLinksLabel}>
            <a href={portfolioLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={portfolioLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href={portfolioLinks.consulting} target="_blank" rel="noreferrer">Consulting ↗</a>
          </div>
          <div class="hero-facts">
            <div><span class="eyebrow">{ui.locationLabel}</span><p>{ui.location}</p></div>
            <div><span class="eyebrow">{ui.focusLabel}</span><p>{ui.focus}</p></div>
          </div>
        </div>
      </section>

      <section id="experience" class="section">
        <div class="section-heading"><span class="section-number">01 —</span><h2>{ui.experience}</h2><span class="section-rule" aria-hidden="true"></span></div>
        <div class="experience-heading">
          <div><h3>Senior Cloud Consultant</h3><p>Oracle, {page.lang === "fr" ? "Genève" : "Geneva"}</p></div>
          <span class="date-badge">{page.experienceSection.oraclePeriod}</span>
        </div>
        <p class="section-intro">{ui.experienceSummary}</p>
        <article class="featured-client-engagement">
          <div class="featured-client-description">
            <div class="client-topline"><h4>{featuredClientEngagement.client}</h4><span class="mission-badge">{page.experienceSection.featuredEngagementLabel}</span></div>
            <h5>{featuredClientEngagement.title}</h5>
            <p>{page.lang === "fr" ? "Landing zones AWS et OCI pour des environnements de développement, staging et production, industrialisées avec Terraform, Ansible et GitHub Actions." : "AWS and OCI landing zones for development, staging and production environments, industrialised with Terraform, Ansible and GitHub Actions."}</p>
            <ul class="tags" aria-label={ui.technologies}>{["AWS", "OCI", "Terraform", "Ansible", "GitHub Actions", "EKS"].map((tool) => <li>{tool}</li>)}</ul>
          </div>
          <ul class="featured-client-highlights">{featuredClientEngagement.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        </article>
        <div class="client-engagement-grid">
          {otherClientEngagements.map((engagement) => (
            <article class="client-engagement-card">
              <h4>{engagement.client}</h4><h5>{engagement.title}</h5>
              <ul>{engagement.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
            </article>
          ))}
          <article class="client-engagement-card cross-client-delivery">
            <h4>{page.experienceSection.crossClientTitle}</h4>
            <ul>{page.crossClientDelivery.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
        <div class="earlier-experience">
          <p class="eyebrow">{ui.earlier}</p>
          {earlierExperiences.map((item) => (
            <article class="earlier-row">
              <span class="earlier-date">{item.dates}</span><h3>{item[page.lang as "fr" | "en"]}</h3><span>{item.company}</span>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="section">
        <div class="section-heading"><span class="section-number">02 —</span><h2>{ui.expertise}</h2><span class="section-rule" aria-hidden="true"></span></div>
        <div class="skills-grid">
          {ui.skills.map((skill, index) => (
            <article class="skill-card">
              <span class="skill-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{skill.title}</h3><p>{skill.description}</p>
              <ul class="compact-tags" aria-label={ui.technologies}>{skill.tools.map((tool) => <li>{tool}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>

      <section id="projects" class="section">
        <div class="section-heading"><span class="section-number">03 —</span><h2>{ui.projects}</h2><span class="section-rule" aria-hidden="true"></span></div>
        <div class="featured-project-grid">
          {[page.featuredProject, page.spotlightProject].map((project) => (
            <article class="featured-project-card">
              <h3>{project.title}</h3>
              <dl>
                <div><dt class="eyebrow">{ui.goal}</dt><dd>{project.description}</dd></div>
                <div><dt class="eyebrow">{ui.demonstrates}</dt><dd>{project.proof}</dd></div>
                <div><dt class="eyebrow">{ui.technologies}</dt><dd><ul class="tags">{project.stack.map((tool) => <li>{tool}</li>)}</ul></dd></div>
              </dl>
              <details class="project-details"><summary>{ui.details}</summary><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></details>
              <a class="project-link" href={project.link} target="_blank" rel="noopener noreferrer">{page.projectsSection.featuredRepositoryLabel}</a>
            </article>
          ))}
        </div>
        <p class="eyebrow other-projects-title">{page.projectsSection.otherEyebrow}</p>
        <div class="projects-grid">
          {page.projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3><p>{project.description}</p>
              <ul class="compact-tags" aria-label={ui.technologies}>{project.stack.map((tool) => <li>{tool}</li>)}</ul>
              <div class="project-actions">
                <a href={project.link} target="_blank" rel="noopener noreferrer">{page.projectsSection.repositoryLabel}</a>
                {"liveUrl" in project && <a class="live-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">{page.projectsSection.liveSiteLabel}</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="education" class="section">
        <div class="section-heading"><span class="section-number">04 —</span><h2>{ui.education}</h2><span class="section-rule" aria-hidden="true"></span></div>
        <div class="education-grid">
          {education.map((item) => <article class="education-card"><h3>{item.title}</h3><p>{item.school} · {item.period}</p></article>)}
        </div>
        <p class="eyebrow other-projects-title">{ui.certifications}</p>
        <ul class="certification-grid">{certifications.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section id="contact" class="section">
        <div class="contact-panel">
          <p class="eyebrow"><span class="section-number">05</span> — Contact</p>
          <h2>{ui.contactFirst}<br /><span class="text-gradient">{ui.contactSecond}</span></h2>
          <a class="button primary email-button" href={`mailto:${portfolioLinks.email}`}>{portfolioLinks.email}</a>
          <div class="profile-links">
            <a href={portfolioLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href={portfolioLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={portfolioLinks.cv}>CV (PDF) ↗</a>
            <a href={portfolioLinks.consulting} target="_blank" rel="noreferrer">Consulting ↗</a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="container"><span>© 2026 Badis Merakchi</span><span>{ui.location}</span></div></footer>
  </body>
</html>
